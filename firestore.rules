rules_version = '2';

/* ==========================================================
   4R BET  |  Firestore Security Rules
   Paste into: Firebase Console > Firestore Database > Rules
   ----------------------------------------------------------
   Summary:
   - Anyone can create a complaint (no login needed).
   - Only the admin can read, update or delete complaints.
   - Support chat: a user has no account, so the random chat id
     in their browser acts as the access key.
   ========================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* The admin login email - keep this in sync with the app code
       (4R-ADMIN/js/auth.js and react-admin/src/lib/fb.js). */
    function adminEmail() {
      return "4r@admin.com";
    }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == adminEmail();
    }

    match /complaints/{complaintId} {

      /* Any visitor can submit a complaint (no login) */
      allow create: if true;

      /* Only the admin can read */
      allow read: if isAdmin();

      /* Only the admin can change the status, and only that field */
      allow update: if isAdmin()
                    && request.resource.data.status is string
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['status', 'statusAt']);

      /* Only the admin can delete */
      allow delete: if isAdmin();
    }

    /* ======================================================
       SUPPORT CHAT
       ------------------------------------------------------
       Users chat without an account, so the random chat id is
       the access key (a chat can only be read if its path is
       known). The admin panel shows the chat list only after
       login.

       NOTE: this is intentionally open for the guest chat. For
       a stricter setup, move chat writes behind an authenticated
       user or a Cloud Function.
       ====================================================== */

    match /chats/{chatId} {

      /* a user can create / update their own chat document */
      allow read: if true;
      allow create, update: if true;

      /* only the admin deletes a whole chat */
      allow delete: if isAdmin();

      match /messages/{msgId} {
        /* messages inside a chat (text / photo / file) */
        allow read, create, update, delete: if true;
      }
    }
  }
}
